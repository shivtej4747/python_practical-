1) password should be minimum characters
2) password should have at least one upper case     characters
3) password should have at least one special character 
 
import re 
password=input("Enter password:")
if len(password)<8:
    print("invalid:password should be minimum             
           characters")
elif not re.search(r"[A-Z]",password):
    print("invalid: should have at least one 
           upper case character")
elif not re.search(r"["\d"]",password):
    print("invalid: should have at least one 
           special character") 
     